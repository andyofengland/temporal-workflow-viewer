<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- When consumed from NuGet, targets are in build/ and DLL is in lib/net10.0/. When used via ProjectReference, targets are in project dir and DLL is in bin/Configuration/net10.0/. -->
  <PropertyGroup>
    <_RoslynWorkflowDiagrammingBuildTaskDir Condition="'$(_RoslynWorkflowDiagrammingBuildTaskDir)' == '' and Exists('$(MSBuildThisFileDirectory)../lib/net10.0/TemporalDashboard.WorkflowDiagramming.Roslyn.Build.dll')">$(MSBuildThisFileDirectory)../lib/net10.0/</_RoslynWorkflowDiagrammingBuildTaskDir>
    <_RoslynWorkflowDiagrammingBuildTaskDir Condition="'$(_RoslynWorkflowDiagrammingBuildTaskDir)' == ''">$(MSBuildThisFileDirectory)bin/$(Configuration)/net10.0/</_RoslynWorkflowDiagrammingBuildTaskDir>
  </PropertyGroup>

  <UsingTask
    TaskName="TemporalDashboard.WorkflowDiagramming.Roslyn.Build.GenerateRoslynWorkflowDiagramsTask"
    AssemblyFile="$(_RoslynWorkflowDiagrammingBuildTaskDir)TemporalDashboard.WorkflowDiagramming.Roslyn.Build.dll" />

  <Target Name="GenerateRoslynWorkflowDiagrams" AfterTargets="Build">
    <!-- Resolve output path inside the target so TargetDir/OutputPath are populated for the current TFM -->
    <PropertyGroup>
      <_GenerateRoslynWorkflowDiagramsOutputPath Condition="'$(GenerateRoslynWorkflowDiagramsOutputPath)' != ''">$(GenerateRoslynWorkflowDiagramsOutputPath)</_GenerateRoslynWorkflowDiagramsOutputPath>
      <_GenerateRoslynWorkflowDiagramsOutputPath Condition="'$(_GenerateRoslynWorkflowDiagramsOutputPath)' == '' and '$(TargetDir)' != ''">$(TargetDir)diagrams</_GenerateRoslynWorkflowDiagramsOutputPath>
      <_GenerateRoslynWorkflowDiagramsOutputPath Condition="'$(_GenerateRoslynWorkflowDiagramsOutputPath)' == ''">$(OutputPath)diagrams</_GenerateRoslynWorkflowDiagramsOutputPath>
    </PropertyGroup>

    <Message
      Condition="'@(Compile)' == ''"
      Importance="normal"
      Text="GenerateRoslynWorkflowDiagrams skipped: no Compile items." />
    <GenerateRoslynWorkflowDiagramsTask
      Condition="'@(Compile)' != ''"
      SourceFiles="@(Compile)"
      ProjectDirectory="$(MSBuildProjectDirectory)"
      OutputPath="$(_GenerateRoslynWorkflowDiagramsOutputPath)"
      FileExtension=".mermaid"
      TargetFramework="$(TargetFramework)"
      Language="C#"
      AssemblyName="$(AssemblyName)"
      AssemblyVersion="$(Version)"
      CreateZip="true" />
  </Target>

</Project>
