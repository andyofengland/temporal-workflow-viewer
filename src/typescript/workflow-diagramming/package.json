{
  "name": "@temporal-dashboard/workflow-diagramming-typescript",
  "version": "0.1.0",
  "description": "Extract Mermaid workflow diagrams from Temporal TypeScript workflows",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "workflow-diagramming-ts": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "tsx src/cli.ts",
    "test": "tsx --test test/extract.test.ts",
    "example": "tsx src/cli.ts examples/sample-workflows --out examples/out --package-name sample-ts-workflows --zip"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  },
  "license": "MIT"
}
